# ── Docker Compose 密钥文件 ──
# 复制此文件为 docker/.env，填入你的真实值
# cp docker/.env.template docker/.env
#
# 重要：docker/.env 已被 .gitignore 忽略，不会被提交到 Git

# LLM API Key（必填 — 替换为你的真实 Key）
OPENAI_API_KEY=sk-your-api-key-here

# LLM 接口地址（可选，默认 DeepSeek）
OPENAI_BASE_URL=https://api.deepseek.com

# LLM 模型名称（可选）
LLM_MODEL=deepseek-v4-flash

# DashScope API Key（用于文本嵌入模型，可选）
DASHSCOPE_API_KEY=

# 日志级别（可选，DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
